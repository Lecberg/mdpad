{
  "extends": "@electron-toolkit/tsconfig/tsconfig.json",
  "include": ["tests/**/*", "src/preload/*.d.ts", "vitest.config.ts", "playwright.config.ts"],
  "compilerOptions": {
    "composite": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"]
    }
  }
}
