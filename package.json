{
  "name": "mdpad",
  "version": "1.0.0",
  "description": "A personal Typora-style WYSIWYG Markdown editor for Windows",
  "main": "./out/main/index.js",
  "author": "mdpad",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "icons": "electron scripts/build-icons.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@lezer/highlight": "1.2.5",
    "@milkdown/crepe": "7.22.3",
    "@milkdown/kit": "7.22.3",
    "@milkdown/react": "7.22.3",
    "@playwright/test": "^1.64.0",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "happy-dom": "^21.0.1",
    "katex": "0.19.0",
    "mdast-util-math": "3.0.0",
    "mdast-util-to-markdown": "2.2.0",
    "mermaid": "11.17.2",
    "micromark-extension-math": "3.1.0",
    "node-diff3": "3.2.1",
    "prettier": "^3.7.4",
    "prosemirror-search": "1.1.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "typescript": "^5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "^7.2.6",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "private": true
}
